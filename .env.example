# apps/api reads these (copy to apps/api/.env)
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/romatlas
CLIENT_ORIGIN=http://localhost:5173

# Auth (REQUIRED in production, must be distinct, >= 32 chars)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Device Assistant (NVIDIA NIM, OpenAI-compatible)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Source sync (importers). Needs `git` and internet access.
SYNC_ENABLED=false          # true = run all importers on a schedule while the API is up
SYNC_INTERVAL_HOURS=24
SYNC_CACHE_DIR=.cache

# Cross-site deployment (frontend and API on different *.onrender.com sites): set to none
COOKIE_SAME_SITE=lax
# Optional: raises the GitHub API limit (60/h -> 5000/h) for the rom-projects sync
GITHUB_TOKEN=
